{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cbu-find-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "vars": {
    "ENVIRONMENT": "local",
    "FIREBASE_PROJECT_ID": "cbu-lost-and-found",
    "FIREBASE_PROJECT_NUMBER": "844398747634",
    "FIREBASE_APP_IDS": "1:844398747634:android:fadeda773c8800078e556b,1:844398747634:web:a763726255f3db478e556b",
    "CLOUDINARY_CLOUD_NAME": "campuslostandfound",
    "WEB_APP_URL": "http://localhost:3000",
    "CORS_ORIGINS": "http://localhost:3000,http://localhost:5173"
  },
  "ratelimits": [
    { "name": "GENERAL_RATE_LIMITER", "namespace_id": "31001", "simple": { "limit": 120, "period": 60 } },
    { "name": "MESSAGE_RATE_LIMITER", "namespace_id": "31002", "simple": { "limit": 40, "period": 60 } },
    { "name": "SENSITIVE_RATE_LIMITER", "namespace_id": "31003", "simple": { "limit": 10, "period": 60 } }
  ],
  "queues": {
    "producers": [
      { "binding": "NOTIFICATION_QUEUE", "queue": "cbu-find-notifications" },
      { "binding": "DELETION_QUEUE", "queue": "cbu-find-deletions" }
    ],
    "consumers": [
      { "queue": "cbu-find-notifications", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "cbu-find-notifications-dlq" },
      { "queue": "cbu-find-deletions", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 8, "dead_letter_queue": "cbu-find-deletions-dlq" }
    ]
  },
  "env": {
    "staging": {
      "name": "cbu-find-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "FIREBASE_PROJECT_ID": "cbu-lost-and-found",
        "FIREBASE_PROJECT_NUMBER": "844398747634",
        "FIREBASE_APP_IDS": "1:844398747634:android:fadeda773c8800078e556b,1:844398747634:web:a763726255f3db478e556b",
        "CLOUDINARY_CLOUD_NAME": "campuslostandfound",
        "WEB_APP_URL": "https://cbu-find-web-staging.leokmabuku.workers.dev",
        "CORS_ORIGINS": "http://localhost:3000,http://localhost:5173,https://cbu-find-web-staging.leokmabuku.workers.dev"
      },
      "ratelimits": [
        { "name": "GENERAL_RATE_LIMITER", "namespace_id": "31101", "simple": { "limit": 120, "period": 60 } },
        { "name": "MESSAGE_RATE_LIMITER", "namespace_id": "31102", "simple": { "limit": 40, "period": 60 } },
        { "name": "SENSITIVE_RATE_LIMITER", "namespace_id": "31103", "simple": { "limit": 10, "period": 60 } }
      ],
      "queues": {
        "producers": [
          { "binding": "NOTIFICATION_QUEUE", "queue": "cbu-find-notifications-staging" },
          { "binding": "DELETION_QUEUE", "queue": "cbu-find-deletions-staging" }
        ],
        "consumers": [
          { "queue": "cbu-find-notifications-staging", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5 },
          { "queue": "cbu-find-deletions-staging", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 8 }
        ]
      }
    },
    "production": {
      "name": "cbu-find-api-production",
      "vars": {
        "ENVIRONMENT": "production",
        "FIREBASE_PROJECT_ID": "cbu-lost-and-found",
        "FIREBASE_PROJECT_NUMBER": "844398747634",
        "FIREBASE_APP_IDS": "1:844398747634:android:fadeda773c8800078e556b,1:844398747634:web:a763726255f3db478e556b",
        "CLOUDINARY_CLOUD_NAME": "campuslostandfound",
        "WEB_APP_URL": "https://example.invalid",
        "CORS_ORIGINS": "https://example.invalid"
      },
      "ratelimits": [
        { "name": "GENERAL_RATE_LIMITER", "namespace_id": "31201", "simple": { "limit": 120, "period": 60 } },
        { "name": "MESSAGE_RATE_LIMITER", "namespace_id": "31202", "simple": { "limit": 40, "period": 60 } },
        { "name": "SENSITIVE_RATE_LIMITER", "namespace_id": "31203", "simple": { "limit": 10, "period": 60 } }
      ],
      "queues": {
        "producers": [
          { "binding": "NOTIFICATION_QUEUE", "queue": "cbu-find-notifications" },
          { "binding": "DELETION_QUEUE", "queue": "cbu-find-deletions" }
        ],
        "consumers": [
          { "queue": "cbu-find-notifications", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "cbu-find-notifications-dlq" },
          { "queue": "cbu-find-deletions", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 8, "dead_letter_queue": "cbu-find-deletions-dlq" }
        ]
      }
    }
  }
}
