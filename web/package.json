{
  "name": "cbu-find-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "vinext build && playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "types": "wrangler types worker-configuration.d.ts --env staging",
    "deploy:dry-run": "vinext build && wrangler deploy --config dist/server/wrangler.json --name cbu-find-web-staging --dry-run",
    "deploy:staging": "vinext build && wrangler deploy --config dist/server/wrangler.json --name cbu-find-web-staging",
    "deploy:production": "vinext build && wrangler deploy --config dist/server/wrangler.json --name cbu-find-web-production"
  },
  "dependencies": {
    "@cbu-find/contracts": "file:../packages/contracts",
    "firebase": "^12.2.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "jsdom": "26.1.0",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
