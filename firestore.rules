rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function role() {
      return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role
        : "USER";
    }
    function moderator() { return role() == "MODERATOR" || role() == "ADMIN"; }
    function admin() { return role() == "ADMIN"; }
    function participant(conversationId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }
    function acceptedClaim(itemId) {
      let path = /databases/$(database)/documents/claims/$(itemId + "_" + request.auth.uid);
      return signedIn() && exists(path) && get(path).data.status == "ACCEPTED";
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || admin();
      allow list: if admin();
      allow create, update, delete: if false;
    }
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /items/{itemId} {
      allow get: if signedIn() && (resource.data.status != "REMOVED" || resource.data.userId == request.auth.uid || moderator());
      allow list: if signedIn() && resource.data.status != "REMOVED";
      allow create, update, delete: if false;
    }
    match /reportContacts/{itemId} {
      allow get: if signedIn() && (resource.data.ownerId == request.auth.uid || acceptedClaim(itemId));
      allow list, create, update, delete: if false;
    }
    match /claims/{claimId} {
      allow get, list: if signedIn() && (resource.data.claimantId == request.auth.uid || resource.data.itemOwnerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create, update, delete: if false;
      match /messages/{messageId} {
        allow read: if participant(conversationId);
        allow create, update, delete: if false;
      }
    }
    match /blocks/{blockId} {
      allow get, list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /notificationPreferences/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /deviceTokens/{tokenId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /roles/{uid} {
      allow get: if isSelf(uid) || admin();
      allow list: if admin();
      allow create, update, delete: if false;
    }
    // Cases contain only the reported target and the server-captured ±2 message window.
    match /moderationCases/{caseId} {
      allow get: if signedIn() && (resource.data.reporterId == request.auth.uid || moderator());
      allow list: if moderator();
      allow create, update, delete: if false;
    }
    match /auditLogs/{entryId} {
      allow read: if admin();
      allow write: if false;
    }
    match /deletionJobs/{uid} {
      allow get: if isSelf(uid) || admin();
      allow list: if admin();
      allow write: if false;
    }
    match /deletionResults/{referenceId} {
      allow read: if admin();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
